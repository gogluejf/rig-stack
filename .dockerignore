# Root build context is used only by vllm-moet. Send the coupled upstream
# patch/cubins and shared entrypoint, not the whole repository.
**
!services/
!services/vllm/
!services/vllm/Dockerfile.moet
!services/vllm/entrypoint.sh
!services/vllm/patches/
!services/vllm/patches/moet-mxfp4-stream-build.patch
!vendor/
!vendor/vllm-Moet/
!vendor/vllm-Moet/patch/
!vendor/vllm-Moet/patch/vllm-moet-v0.24.0.patch
!vendor/vllm-Moet/kernels/
!vendor/vllm-Moet/kernels/cubins-sm120/
!vendor/vllm-Moet/kernels/cubins-sm120/**
